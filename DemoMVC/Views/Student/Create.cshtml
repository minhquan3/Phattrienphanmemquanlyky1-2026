@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h1>Thêm sinh viên</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <!-- Họ tên -->
            <div class="mb-3">
                <label asp-for="Fullname"
                       class="form-label">
                    Họ và tên
                </label>

                <input asp-for="Fullname"
                       class="form-control" />

                <span asp-validation-for="Fullname"
                      class="text-danger">
                </span>
            </div>

            <!-- Địa chỉ -->
            <div class="mb-3">
                <label asp-for="Address"
                       class="form-label">
                    Địa chỉ
                </label>

                <input asp-for="Address"
                       class="form-control" />

                <span asp-validation-for="Address"
                      class="text-danger">
                </span>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <!-- Tuổi -->
            <div class="mb-3">
                <label asp-for="Age"
                       class="form-label">
                    Tuổi
                </label>

                <input asp-for="Age"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Age"
                      class="text-danger">
                </span>
            </div>

            <!-- GPA -->
            <div class="mb-3">
                <label asp-for="GPA"
                       class="form-label">
                    GPA
                </label>

                <input asp-for="GPA"
                       class="form-control"
                       type="number"
                       step="0.01" />

                <span asp-validation-for="GPA"
                      class="text-danger">
                </span>
            </div>

            <!-- Trường đại học -->
            <div class="mb-3">
                <label asp-for="University"
                       class="form-label">
                    Trường đại học
                </label>

                <input asp-for="University"
                       class="form-control" />

                <span asp-validation-for="University"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Thêm sinh viên
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}